{
  "buildCommand": "npm run build",
  "framework": null,
  "functions": {
    "api/index.js": {
      "includeFiles": "server/src/schema.sql",
      "maxDuration": 30
    },
    "api/invoice-proposal-upload.js": {
      "includeFiles": "server/src/schema.sql",
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/portal.html",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/invoice-proposals",
      "has": [{ "type": "header", "key": "content-type", "value": "application/pdf" }],
      "destination": "/api/invoice-proposal-upload"
    },
    {
      "source": "/api/integrations/invoice-proposals",
      "has": [{ "type": "header", "key": "content-type", "value": "application/pdf" }],
      "destination": "/api/invoice-proposal-upload"
    },
    { "source": "/api/(.*)", "destination": "/api" }
  ]
}
