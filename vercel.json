{
  "buildCommand": "npm run build",
  "framework": null,
  "functions": {
    "api/index.js": {
      "includeFiles": "server/src/schema.sql"
    },
    "api/invoice-proposal-upload.js": {
      "includeFiles": "server/src/schema.sql",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/invoice-proposals",
      "has": [{ "type": "header", "key": "content-type", "value": "application/pdf" }],
      "destination": "/api/invoice-proposal-upload"
    },
    {
      "source": "/api/integrations/invoice-proposals",
      "has": [{ "type": "header", "key": "content-type", "value": "application/pdf" }],
      "destination": "/api/invoice-proposal-upload"
    },
    { "source": "/api/(.*)", "destination": "/api" }
  ]
}
