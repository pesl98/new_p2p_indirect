{
  "name": "procurement-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "seed": "node server/src/seed.js",
    "db:migrate": "node server/scripts/db-migrate.js",
    "db:status": "node server/scripts/db-status.js",
    "db:seed:preview": "node server/scripts/seed-preview.js",
    "db:invoice-proposal-pdf-column": "node server/scripts/invoice-proposal-pdf-column.js",
    "bootstrap-admin": "node server/src/bootstrapAdmin.js",
    "bootstrap-org": "node server/scripts/bootstrap-org.js",
    "provision:customer": "node server/scripts/provision-customer.js",
    "onboard:customer": "node server/scripts/onboard-customer.js",
    "turso:customer": "node server/scripts/turso-customer.js",
    "vercel:customer": "node server/scripts/vercel-customer.js",
    "offboard:customer": "node server/scripts/offboard-customer.js",
    "smoke": "node server/scripts/smoke.js",
    "start": "node server/src/index.js",
    "start:server": "node server/src/index.js",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "test": "node --test server/src/*.test.js client/src/documentTrailNav.test.js client/src/i18n.test.js client/src/money.test.js",
    "build": "npm --prefix client install && npm --prefix client run build && rm -rf public && mkdir -p public && cp -r client/dist/. public/"
  },
  "dependencies": {
    "@node-saml/node-saml": "^5.1.0",
    "@vercel/functions": "^3.9.11",
    "ai": "^7.0.133",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jose": "^6.2.12",
    "openid-client": "^6.8.8",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
