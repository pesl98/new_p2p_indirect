# ProcureFlow environment template
#
# Copy to `.env` (gitignored) or set the same keys in the Vercel project.
# Never commit secrets. One Turso database / SQLite file per customer —
# do not reuse TURSO_DATABASE_URL across customers.

# --- Database (Turso XOR local SQLite) ---
# Both required together for Turso / Vercel. Omit both for local SQLite.
# TURSO_DATABASE_URL=libsql://customer-x.turso.io
# TURSO_AUTH_TOKEN=

# Local SQLite path (used only when both TURSO_* are unset)
# PROCUREMENT_DB_PATH=server/data/customer.db

# --- Auth ---
# Required for customer / Vercel deploys. Signs the httpOnly pf_session cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# Demo-only header persona switcher. Leave unset/0 for real customers.
# DEMO_PERSONA_SWITCHER=0

# bcrypt cost for password hashes (default 10)
# BCRYPT_ROUNDS=10

# --- App ---
# PORT=5000
# NODE_ENV=development

# --- Smoke (npm run smoke) ---
# Local default, or the customer Vercel URL after deploy:
BASE_URL=http://127.0.0.1:5000
# Optional login check after bootstrap-admin:
# SMOKE_EMAIL=admin@customer.com
# SMOKE_PASSWORD=
# SMOKE_TIMEOUT_MS=15000

# --- Operator notes ---
# Real customer:
#   export TURSO_* + SESSION_SECRET
#   npm run vercel:customer -- --slug <customer>            # dry-run
#   npm run vercel:customer -- --slug <customer> --apply    # Production+Preview env + redeploy
#   npm run db:migrate && npm run bootstrap-org && npm run bootstrap-admin && npm run smoke
# (or: npm run provision:customer -- --with-org --email … --password …)
# Three tiers:    db:migrate (empty schema) → bootstrap-org (cost centers) → seed (DESTRUCTIVE demo)
# Demo wipe:      npm run seed     # DESTRUCTIVE — not for live tenants
# Docs:           docs/SYSTEM_MANUAL.md        (capabilities + deploy overview)
#                 docs/CUSTOMER_ONBOARDING.md  (operator runbook)
#                 docs/DEPLOYMENT.md  scripts/provision-customer.md
