# ProcureFlow environment template
#
# Copy to `.env` (gitignored) or set the same keys in the Vercel project.
# Never commit secrets. One Turso database / SQLite file per customer —
# do not reuse TURSO_DATABASE_URL across customers.

# --- Database (Turso XOR local SQLite) ---
# Both required together for Turso / Vercel. Omit both for local SQLite.
# TURSO_DATABASE_URL=libsql://customer-x.turso.io
# TURSO_AUTH_TOKEN=
#
# Preview (VERCEL_ENV=preview) refuses to open the production database.
# Create procureflow-<slug>-preview in the same Turso group and location.
# Set the preview pair on Vercel Preview only. Production ignores them.
# TURSO_PREVIEW_DATABASE_URL=libsql://customer-x-preview.turso.io
# TURSO_PREVIEW_AUTH_TOKEN=
# Optional production URL for the host check. No token. Not required when
# Preview has only the preview pair. Compared whenever it, or TURSO_DATABASE_URL
# or TURSO_AUTH_TOKEN, is visible on Preview.
# TURSO_PRODUCTION_DATABASE_URL=libsql://customer-x.turso.io
# Escape hatch. The only recognized value is the exact word allow.
# It logs an error and serves the production database from Preview. Leave unset.
# ALLOW_PREVIEW_PRODUCTION_DATABASE=

# Local SQLite path (used only when both TURSO_* are unset)
# PROCUREMENT_DB_PATH=server/data/customer.db

# --- Auth ---
# Required for customer / Vercel deploys. Signs the httpOnly pf_session cookie.
# Generate: npm run turso:customer -- --slug <customer> --apply
#   (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# SESSION_SECRET=
# Startup fails in production / on Vercel when this is unset.

# Comma-separated browser origins allowed to call the API with cookies.
# Unset = same-origin only in production (any origin in local dev).
# CORS_ORIGINS=https://app.customer.example

# Demo-only header persona switcher. Leave unset/0 for real customers.
# DEMO_PERSONA_SWITCHER=0

# bcrypt cost for password hashes (default 10)
# BCRYPT_ROUNDS=10

# --- SSO (optional, this customer only) ---
# local (default) | oidc | saml. Missing IdP settings fail closed (no session).
# IDENTITY_PROVIDER=local
# Public origin of this deployment. Required for OIDC/SAML redirects.
# APP_BASE_URL=https://procureflow-acme.vercel.app
# Password login stays on unless this is 0.
# LOCAL_LOGIN=1
# Unknown IdP users are rejected unless provisioning is on.
# SSO_PROVISIONING=0
# Role for just-in-time users. One of requester|approver|procurement|finance|admin.
# Never taken from the IdP. Default requester.
# SSO_DEFAULT_ROLE=requester
#
# OIDC (IDENTITY_PROVIDER=oidc). Register the redirect URI on the IdP.
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://procureflow-acme.vercel.app/api/auth/oidc/callback
# OIDC_SCOPES=openid email profile
#
# SAML (IDENTITY_PROVIDER=saml). Give the IdP GET /api/auth/saml/metadata.
# SAML_ENTRY_POINT=https://idp.example.com/sso
# SAML_IDP_CERT=
# SAML_IDP_ISSUER=https://idp.example.com/metadata
# SAML_SP_ENTITY_ID=https://procureflow-acme.vercel.app/saml
# SAML_ACS_URL=https://procureflow-acme.vercel.app/api/auth/saml/acs
# SAML_AUDIENCE=
# SAML_WANT_ASSERTIONS_SIGNED=1
# SAML_WANT_RESPONSE_SIGNED=0

# --- Integrations (optional, this customer only) ---
# Not set by onboard:customer or vercel:customer. Not stored in the database.
# The admin UI reports whether they are set. It never returns the secret or the URL.
# WEBHOOK_TARGET_URL=https://erp.example.com/hooks/procureflow
# WEBHOOK_SIGNING_SECRET=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- PDF invoice proposals (optional; fail closed when unset) ---
# Production provider is the Vercel AI Gateway. Leave both unset to disable upload.
# INVOICE_OCR_PROVIDER=gateway
# INVOICE_OCR_MODEL=google/gemini-2.5-flash
# AI_GATEWAY_API_KEY=
# Max raw PDF size. Default and ceiling are 4194304 (4 MiB).
# INVOICE_PDF_MAX_BYTES=4194304
# Per-attempt OCR timeout in ms. Default 20000. One retry after 1s.
# Integers above 24500 are clamped so two attempts fit in the 60s upload function.
# INVOICE_OCR_TIMEOUT_MS=20000
# Signed-in uploads per user per minute. Default 10. Integer 1-600.
# INVOICE_PROPOSAL_UPLOADS_PER_MINUTE=10
# enforce (default) or off. off is for a single-person tenant only.
# enforce blocks the uploader and the user who created the uploading API key.
# INVOICE_PROPOSAL_SOD=enforce

# --- Buyer RFQ drafts (optional; off unless set) ---
# Not written by onboard:customer or vercel:customer.
# 1, true, or yes turns the module on. Anything else, including unset, leaves it off.
# Set on Production only until this customer runs a live RFQ. Preview stays off.
# SOURCING_ENABLED=1
# Optional PDF cap in bytes. Default and maximum are 4194304 (4 MiB).
# SOURCING_PDF_MAX_BYTES=4194304
# Required to publish or open a supplier link. Minimum 32 characters. Production only.
# PORTAL_TOKEN_SECRET=
# Links use the APP_BASE_URL above: https://<APP_BASE_URL>/portal.html#t=...
# Shown on the supplier portal. Defaults to ProcureFlow.
# APP_NAME=ProcureFlow
# Trust X-Forwarded-For only behind a known proxy. Vercel sets this itself.
# Set TRUST_PROXY=1 when a reverse proxy in front of a non-Vercel host appends the client address.
# TRUST_PROXY=
# Mail is optional. none (default) means the buyer copies the link. smtp needs the two settings below.
# An invalid provider or a missing From/URL skips the send and does not stop the app.
# MAIL_PROVIDER=none
# MAIL_FROM=inkoop@example.com
# MAIL_REPLY_TO=inkoop@example.com
# MAIL_SMTP_URL=smtp://user:pass@smtp.example.com:587

# --- Currency (one code per deployment; not FX) ---
# Unset or blank is EUR. Allowlist: EUR, USD. Any other value refuses to boot.
# Display locale is nl-NL (€ 1.295,00). Stored amounts stay integer cents.
# CURRENCY=EUR

# --- App ---
# PORT=5000
# NODE_ENV=development

# --- Smoke (npm run smoke) ---
# Local default, or the customer Vercel URL after deploy:
BASE_URL=http://127.0.0.1:5000
# Optional login check after bootstrap-admin:
# SMOKE_EMAIL=admin@customer.com
# SMOKE_PASSWORD=
# SMOKE_TIMEOUT_MS=15000

# --- Vercel Production Ready wait (vercel:customer --apply / onboard:customer --apply) ---
# After redeploy or deploy --prod, poll `vercel inspect <deployment> --json`
# until readyState is READY. Default 240000 (4 minutes). Non-positive or
# non-numeric values fall back to the default. Timeout, ERROR, or CANCELED
# exits non-zero (check the Vercel dashboard or redeploy).
# VERCEL_READY_TIMEOUT_MS=240000

# --- Operator notes ---
# Real customer (preferred):
#   npm run onboard:customer -- --slug <customer>           # dry-run
#   npm run onboard:customer -- --slug <customer> --apply --email … --password …
# Stepped (same sequence; copy Turso export lines by hand):
#   npm run turso:customer -- --slug <customer>             # dry-run
#   npm run turso:customer -- --slug <customer> --apply     # DB + token + SESSION_SECRET exports
#   npm run vercel:customer -- --slug <customer>            # dry-run (project add + link + env)
#   npm run vercel:customer -- --slug <customer> --apply    # ensure + link + Production+Preview env + redeploy
#   npm run provision:customer -- --with-org --email … --password …
#   BASE_URL=https://<customer>.vercel.app npm run smoke
# Deprovision:    npm run offboard:customer -- --slug <customer>          # dry-run
#                 npm run offboard:customer -- --slug <customer> --apply --confirm-slug <customer>
#                 strips Production+Preview TURSO_* + SESSION_SECRET, then turso db destroy
#                 leaves the Vercel project; does not seed
# Three tiers:    db:migrate (empty schema) → bootstrap-org (cost centers) → seed (DESTRUCTIVE demo)
# Demo wipe:      npm run seed     # DESTRUCTIVE — not for live tenants
# Docs:           docs/DEPLOY_MANUAL.md        (authoritative deploy / operations manual)
#                 docs/SYSTEM_MANUAL.md        (capabilities overview)
#                 docs/CUSTOMER_ONBOARDING.md  (shorter runbook)
#                 docs/DEPLOYMENT.md  scripts/provision-customer.md
