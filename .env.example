# ProcureFlow environment template
#
# Copy to `.env` (gitignored) or set the same keys in the Vercel project.
# Never commit secrets. One Turso database / SQLite file per customer —
# do not reuse TURSO_DATABASE_URL across customers.

# --- Database (Turso XOR local SQLite) ---
# Both required together for Turso / Vercel. Omit both for local SQLite.
# TURSO_DATABASE_URL=libsql://customer-x.turso.io
# TURSO_AUTH_TOKEN=

# Local SQLite path (used only when both TURSO_* are unset)
# PROCUREMENT_DB_PATH=server/data/customer.db

# --- Auth ---
# Required for customer / Vercel deploys. Signs the httpOnly pf_session cookie.
# Generate: npm run turso:customer -- --slug <customer> --apply
#   (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# SESSION_SECRET=

# Demo-only header persona switcher. Leave unset/0 for real customers.
# DEMO_PERSONA_SWITCHER=0

# bcrypt cost for password hashes (default 10)
# BCRYPT_ROUNDS=10

# --- App ---
# PORT=5000
# NODE_ENV=development

# --- Smoke (npm run smoke) ---
# Local default, or the customer Vercel URL after deploy:
BASE_URL=http://127.0.0.1:5000
# Optional login check after bootstrap-admin:
# SMOKE_EMAIL=admin@customer.com
# SMOKE_PASSWORD=
# SMOKE_TIMEOUT_MS=15000

# --- Vercel Production Ready wait (vercel:customer --apply / onboard:customer --apply) ---
# After redeploy or deploy --prod, poll `vercel inspect <deployment> --json`
# until readyState is READY. Default 240000 (4 minutes). Non-positive or
# non-numeric values fall back to the default. Timeout, ERROR, or CANCELED
# exits non-zero (check the Vercel dashboard or redeploy).
# VERCEL_READY_TIMEOUT_MS=240000

# --- Operator notes ---
# Real customer (preferred):
#   npm run onboard:customer -- --slug <customer>           # dry-run
#   npm run onboard:customer -- --slug <customer> --apply --email … --password …
# Stepped (same sequence; copy Turso export lines by hand):
#   npm run turso:customer -- --slug <customer>             # dry-run
#   npm run turso:customer -- --slug <customer> --apply     # DB + token + SESSION_SECRET exports
#   npm run vercel:customer -- --slug <customer>            # dry-run (project add + link + env)
#   npm run vercel:customer -- --slug <customer> --apply    # ensure + link + Production+Preview env + redeploy
#   npm run provision:customer -- --with-org --email … --password …
#   BASE_URL=https://<customer>.vercel.app npm run smoke
# Deprovision:    npm run offboard:customer -- --slug <customer>          # dry-run
#                 npm run offboard:customer -- --slug <customer> --apply --confirm-slug <customer>
#                 strips Production+Preview TURSO_* + SESSION_SECRET, then turso db destroy
#                 leaves the Vercel project; does not seed
# Three tiers:    db:migrate (empty schema) → bootstrap-org (cost centers) → seed (DESTRUCTIVE demo)
# Demo wipe:      npm run seed     # DESTRUCTIVE — not for live tenants
# Docs:           docs/DEPLOY_MANUAL.md        (authoritative deploy / operations manual)
#                 docs/SYSTEM_MANUAL.md        (capabilities overview)
#                 docs/CUSTOMER_ONBOARDING.md  (pointer to the deploy manual)
#                 docs/DEPLOYMENT.md  scripts/provision-customer.md
